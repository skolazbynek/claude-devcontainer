FROM claude-base:latest

USER root

# Install editors: classic vim (no plugins) + apt build deps already in base
RUN apt-get update && apt-get install -y vim && rm -rf /var/lib/apt/lists/*

USER claude

# Neovim must stay >= 0.12: the dotfiles pin nvim-treesitter to its `main`
# branch, which calls 0.12-only APIs (vim.list.*) and hard-fails parser
# installation on 0.11, leaving every buffer without a parser.
RUN curl -fsSL https://github.com/neovim/neovim/releases/download/v0.12.5/nvim-linux-x86_64.tar.gz -o ~/.tmp/nvim.tar.gz && \
    tar -xzf ~/.tmp/nvim.tar.gz -C ~/.opt && \
    ln -s ~/.opt/nvim-linux-x86_64/bin/nvim ~/.local/bin/nvim && \
    rm -f ~/.tmp/nvim.tar.gz

# Install tree-sitter CLI (required by nvim-treesitter `main` branch to
# generate/compile parsers; the legacy bundled parser.c approach is gone).
# Upstream README warns against the npm package -- use the Rust release binary.
RUN curl -fsSL https://github.com/tree-sitter/tree-sitter/releases/download/v0.26.1/tree-sitter-linux-x64.gz -o ~/.tmp/tree-sitter.gz && \
    gunzip ~/.tmp/tree-sitter.gz && \
    mv ~/.tmp/tree-sitter ~/.opt/tree-sitter && \
    chmod +x ~/.opt/tree-sitter && \
    ln -s ~/.opt/tree-sitter ~/.local/bin/tree-sitter

USER root

# Copy devcontainer entrypoint (context: repo root)
COPY imgs/claude-devcontainer/entrypoint-claude-devcontainer.sh /workspace/container_run.sh
RUN chmod +x /workspace/container_run.sh && chown claude:claude /workspace/container_run.sh

USER claude

# `cld` inside a container is the container-side app (docs/design-cli-split.md), not
# the host one: it needs no docker daemon and only carries verbs that work here. A
# shim rather than a console script -- the package is COPY'd into /opt/cld with
# PYTHONPATH, never pip-installed, so there is nothing to generate an entry point.
# -P keeps cwd off sys.path, so a repo that happens to contain a `cld/` package
# (this one) cannot shadow the baked copy.
RUN printf '#!/bin/sh\nexec python3 -P -m cld.cli_container "$@"\n' > /home/claude/.local/bin/cld \
    && chmod +x /home/claude/.local/bin/cld

ENTRYPOINT ["/workspace/container_run.sh"]
