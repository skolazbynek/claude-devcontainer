FROM python:3.13-slim-trixie

# Create a non-root user with UID 1000
RUN useradd -m -u 1000 -s /bin/bash claude && \
    mkdir -p /workspace/origin /workspace/current && \
    chown -R claude:claude /workspace

# Install essential tools (as root)
# bubblewrap, socat are for claude sandbox mode
RUN apt-get update && apt-get install -y \
    git \
    ca-certificates \
    curl \
    bubblewrap \
    socat \
    jq \
    default-mysql-client-core \
    nodejs \
    npm \
    ripgrep \
    fd-find \
    build-essential \
    cmake \
    unzip \
    golang-go \
    && rm -rf /var/lib/apt/lists/*

# Watchman: needed for jj's fsmonitor.backend=watchman + register-snapshot-trigger,
# which drives autonomous snapshots inside the container-ephemeral workspace so
# uncommitted edits survive `docker rm && docker run` via the origin's jj store.
# Pin to a verified release; do not track "latest".
RUN apt-get update && apt-get install -y --no-install-recommends unzip && \
    curl -fsSL -o /tmp/w.zip https://github.com/facebook/watchman/releases/download/v2026.07.06.00/watchman-v2026.07.06.00-linux.zip && \
    unzip -q /tmp/w.zip -d /tmp && \
    cp /tmp/watchman-*/bin/* /usr/local/bin/ && \
    cp -r /tmp/watchman-*/lib/* /usr/local/lib/ && \
    ldconfig && \
    chmod 755 /usr/local/bin/watchman* && \
    mkdir -p /usr/local/var/run/watchman && chmod 1777 /usr/local/var/run/watchman && \
    apt-get purge -y unzip && rm -rf /var/lib/apt/lists/* /tmp/w.zip /tmp/watchman-*

USER claude

RUN mkdir ~/.tmp && \
    mkdir ~/.opt && \
    mkdir ~/.local && \
    mkdir ~/.local/bin && \
    ln -s /usr/local/bin/python3 ~/.local/bin/python

# Install jj binary
RUN curl -fsSL https://github.com/jj-vcs/jj/releases/download/v0.37.0/jj-v0.37.0-x86_64-unknown-linux-musl.tar.gz -o ~/.tmp/jj.tar.gz && \
    tar -xzf ~/.tmp/jj.tar.gz -C ~/.opt && \
    ln -s ~/.opt/jj ~/.local/bin/jj && \
    rm -f ~/.tmp/jj.tar.gz

# Install Docker CLI (static binary, used by messenger's list_agents via `docker ps`)
RUN curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-27.5.1.tgz -o ~/.tmp/docker.tgz && \
    tar -xzf ~/.tmp/docker.tgz --strip-components=1 -C ~/.local/bin docker/docker && \
    rm -f ~/.tmp/docker.tgz

# Install Poetry (Python package manager)
RUN curl -sSL https://install.python-poetry.org | POETRY_HOME=~/.opt/poetry python3 - && \
    ln -s ~/.opt/poetry/bin/poetry ~/.local/bin/poetry

# Install uv/uvx (needed by uvx-based MCP servers, e.g. mcp-grafana)
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="$HOME/.local/bin" sh

# Install cld runtime dependencies (keep in sync with pyproject.toml).
RUN pip install --user "mcp[cli]>=1.0" "typer>=0.9" "pyyaml>=6.0,<7.0"

# Install Claude (installs to user directory)
RUN curl -fsSL https://claude.ai/install.sh | bash

# Add ~/.local/bin to PATH for claude command
ENV PATH="/home/claude/.local/bin:${PATH}"

WORKDIR /workspace

USER root

# Bake internal (Seznam) CA certificates into the system trust store so
# python/requests/pip/poetry and other subprocesses trust them without
# depending on any host mount. `update-ca-certificates` picks up any
# .crt file under /usr/local/share/ca-certificates/ and rewrites the
# concatenated bundle at /etc/ssl/certs/ca-certificates.crt.
COPY imgs/claude-base/ca-certs/seznam/ /tmp/seznam-ca/
RUN mkdir -p /usr/local/share/ca-certificates/seznam && \
    for f in /tmp/seznam-ca/*.pem; do \
        cp "$f" "/usr/local/share/ca-certificates/seznam/$(basename "${f%.pem}").crt"; \
    done && \
    rm -rf /tmp/seznam-ca && \
    update-ca-certificates

# Point every consumer at the system trust store. OpenSSL-based tools
# (python stdlib, jj, git, curl) already read it; certifi-based tools
# (requests, pip, poetry) need REQUESTS_CA_BUNDLE; Node needs its own env.
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Disable Claude Code's Bash sandbox: the container itself (cap-drop ALL,
# no-new-privileges, ephemeral, host UID, scoped mounts) is the trust
# boundary, so the in-process sandbox layer adds only friction (refuses
# legitimate VCS writes in headless runs). Managed settings have highest
# precedence and live outside $HOME, so the host's ~/.claude bind-mount
# cannot shadow them.
RUN mkdir -p /etc/claude-code
COPY imgs/claude-base/managed-settings.json /etc/claude-code/managed-settings.json

# Copy shared shell helpers (context: repo root)
COPY imgs/claude-devcontainer/container-init.sh imgs/claude-devcontainer/vcs-lib.sh ./
RUN chmod +x container-init.sh vcs-lib.sh && \
    chown claude:claude container-init.sh vcs-lib.sh

# Bake in cld package and prompts. PYTHONPATH makes `import cld` work for any
# in-container invocation (e.g. baked MCP servers run as scripts), since the
# package is COPY'd rather than installed.
COPY --chown=claude:claude cld/ /opt/cld/cld/
COPY --chown=claude:claude prompts/ /opt/cld/prompts/
ENV PYTHONPATH=/opt/cld

# Bake in cld's own tool skills (e.g. agent-start, messenger-*) so they're
# available in every container regardless of which repo is mounted at
# /workspace/origin -- including sibling master_targets repos, which never
# see this repo's own .claude/skills/. Loaded via `claude --add-dir /opt/cld`
# (any .claude/skills/ under an --add-dir path auto-loads) rather than
# copying into $HOME/.claude/skills, since $HOME/.claude is a live RW bind
# mount back to the host's real ~/.claude -- writing there would leak
# container-only symlinks onto the host.
COPY --chown=claude:claude .claude/skills/ /opt/cld/.claude/skills/

USER claude
