# Broker config -- sourced by cld-broker.sh. Copy to /etc/cld/broker.conf
# (or point CLD_BROKER_CONF at it).
#
# The broker serves ANY repo that has a running master: it resolves the target
# repo from the calling master container's org.cld.repo-root label, and the
# secrets path from that repo's own cld config (pyproject_dir, default .).
# So there is nothing per-repo to configure here -- only broker-wide settings.

RUNTESTS_IMAGE=runtests:latest

# The forced command runs with a minimal PATH; make jj, docker, and cld (the
# `agent` action runs host-side `cld agent`) -- plus any other tools your
# actions call -- reachable:
# PATH=/home/you/.local/bin:/usr/local/bin:/usr/bin:/bin
